# Requires NVIDIA GPU, NVIDIA Container Toolkit, CUDA 12 and cuDNN 9.
# Hosts Handy FastAPI + Whisper. Run Qwen in a separate private vLLM service.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv ca-certificates libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/venv
WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
COPY handy_server /app/handy_server
RUN pip install --no-cache-dir -e ".[asr]"
RUN useradd --create-home handy && mkdir -p /app/data /home/handy/.cache && \
    chown -R handy:handy /app/data /home/handy
ENV HOME=/home/handy HF_HOME=/home/handy/.cache/huggingface
USER handy
EXPOSE 8765
CMD ["uvicorn", "handy_server.main:app", "--host", "0.0.0.0", "--port", "8765"]
