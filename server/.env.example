# Generate a random secret (never commit an actual one):
HANDY_API_KEY=replace-with-long-random-secret
HANDY_DB_PATH=./data/handy.sqlite3
HANDY_CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Whisper Large V3, loaded once when the API boots; requires server[asr].
HANDY_ASR_ENABLED=false
HANDY_ASR_MODEL=large-v3
HANDY_ASR_DEVICE=cuda
HANDY_ASR_COMPUTE_TYPE=float16
HANDY_MAX_AUDIO_BYTES=26214400

# Qwen3.5-9B through a private OpenAI-compatible vLLM endpoint.
HANDY_LLM_ENABLED=false
HANDY_QWEN_BASE_URL=http://127.0.0.1:8000/v1
HANDY_QWEN_MODEL=Qwen/Qwen3.5-9B
HANDY_QWEN_API_KEY=EMPTY
HANDY_MAX_TEXT_CHARS=12000
