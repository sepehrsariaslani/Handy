# Required. Generate a long random value (e.g. python -c 'import secrets; print(secrets.token_urlsafe(48))')
HANDY_API_KEY=replace-with-long-random-secret
# Local single-server storage for session metadata (not audio)
HANDY_DB_PATH=./data/handy.sqlite3
# Do not expose the service directly to the internet: put it behind HTTPS.
HANDY_CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
